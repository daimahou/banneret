filters:
  and:
    - file.folder == "skills"
properties:
  note.specialization:
    displayName: Spec
views:
  - type: table
    name: All upgrades
    groupBy:
      property: skill
      direction: ASC
    order:
      - file.name
      - summary
    columnSize:
      file.name: 137
  - type: table
    name: Upgrades
    filters:
      and:
        - base == this.asLink()
    order:
      - file.name
      - summary
      - class
    sort:
      - property: file.name
        direction: DESC
      - property: affinity
        direction: ASC
      - property: effect
        direction: ASC
    columnSize:
      file.name: 182
      note.summary: 332
  - type: table
    name: Specialization
    filters:
      and:
        - specialization == this.asLink()
    groupBy:
      property: skill
      direction: ASC
    order:
      - file.name
  - type: table
    name: Non-allocated
    filters:
      and:
        - file.folder == "Skills/Upgrades"
    order:
      - file.name
      - skill
      - specialization
      - class
