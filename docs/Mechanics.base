filters:
  and:
    - file.folder == "mechanics"
    - file.ext == "md"
properties:
  file.name:
    displayName: Mechanic
views:
  - type: table
    name: Mechanics
    groupBy:
      property: type
      direction: ASC
    order:
      - gate
      - file.name
      - class
      - summary
      - type
    sort:
      - property: file.name
        direction: ASC
      - property: summary
        direction: ASC
    columnSize:
      file.name: 186
      note.class: 126
      note.summary: 601
      note.type: 198
  - type: table
    name: Class mechanics
    filters:
      and:
        - class == this.asLink()
    order:
      - file.name
      - summary
  - type: table
    name: By Type
    filters:
      and:
        - type == this.asLink()
    order:
      - file.name
      - summary
    columnSize:
      file.name: 164
  - type: table
    name: By Relation
    filters:
      and:
        - related.contains(this.asLink())
